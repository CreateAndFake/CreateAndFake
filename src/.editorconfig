[*.cs]

# Not supported in all .NET versions.
dotnet_diagnostic.CA1847.severity = None

# Requiring message based constructors are unnecessary and hinders design.
dotnet_diagnostic.CA1032.severity = None
dotnet_diagnostic.RCS1194.severity = None

# False positive when adding a <param/> tag while also using <inheritdoc/> tag.
dotnet_diagnostic.CS1573.severity = None

# Bad rules that advocate for less maintainable documentation.
dotnet_diagnostic.MA0197.severity = None
dotnet_diagnostic.MA0203.severity = None

# Doesn't account for overloads.
dotnet_diagnostic.CA1019.severity = None
